  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://vxejoefeufqaplfsbcpy.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_2YRXqqCNGeIf65o_Rqx3OA_lLe_9Lmf",
    "META_EXTERNAL_WRITES_ENABLED": "false"
  }
}
